# Copy to .env.local for local development. All optional locally.
# Unset DATABASE_URL = embedded PGlite under .data/pglite
# DATABASE_URL=postgres://...neon.tech/neondb?sslmode=require
# Initial admin password only. Generate with: npm run hash-password (unset = dev "idea-funnel")
# After initialization, change passwords from Settings.
# PASSWORD_HASH=pbkdf2$100000$...$...
