{
  "name": "idea-funnel",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/entry/node.ts\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "hash-password": "tsx scripts/hash-password.ts",
    "verify:vercel": "rm -rf .data/vercel-check && tsc -p tsconfig.json --noEmit false --outDir .data/vercel-check && node scripts/verify-vercel-function.mjs .data/vercel-check",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:local": "node scripts/pg-local.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:check": "prisma validate && prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code"
  },
  "type": "module",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/react-query": "^5.105.0",
    "dompurify": "^3.4.17",
    "hono": "^4.13.14",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@hono/node-server": "^2.1.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "private": true
}
